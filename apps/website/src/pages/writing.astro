---
import Page from "@/layouts/page.astro";
import { identity, person, personRef } from "@/lib/person";
import { writing } from "@/lib/writing";

export const prerender = true;

const title = "Writing";
const description =
  "Notes on backend engineering — returns systems, rule engines and the things I learn building commerce at scale.";

const jsonLd = {
  "@context": "https://schema.org",
  "@id": `${identity}/writing#webpage`,
  "@type": "CollectionPage",
  about: person,
  description,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: writing.map((item, index) => ({
      "@type": "ListItem",
      item: {
        "@type": item.schemaType ?? "Article",
        author: item.coAuthors
          ? [
              personRef,
              ...item.coAuthors.map((coAuthor) => ({
                "@type": "Person",
                name: coAuthor.name,
                url: coAuthor.url,
              })),
            ]
          : personRef,
        headline: item.title,
        url: item.url,
      },
      position: index + 1,
    })),
  },
  name: "Writing by Umang Kumar",
  url: `${identity}/writing`,
};
---

<Page description={description} jsonLd={jsonLd} title={title}>
  {
    writing.length === 0 ? (
      <div class="grid gap-2">
        <p class="text-zinc-600 leading-relaxed transition-colors duration-300 dark:text-zinc-400">
          First posts are in the works — rebuilding returns reallocation for a
          million orders a day, and a rule engine that ships business changes
          with zero deploys.
        </p>
        <p class="text-sm text-zinc-500">
          Check back soon, or follow along on{" "}
          <a
            class="text-black underline dark:text-white"
            href="https://www.linkedin.com/in/umangkumarr/"
            rel="noopener noreferrer"
            target="_blank"
          >
            LinkedIn
          </a>
          .
        </p>
      </div>
    ) : (
      <div class="grid gap-8">
        {writing.map((item) => (
          <a
            class="group grid gap-1"
            href={item.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-medium leading-relaxed transition-colors duration-300 group-hover:text-zinc-500">
                {item.title}
              </h2>
              <span class="shrink-0 text-sm text-zinc-500 tabular-nums">
                {item.year}
              </span>
            </div>
            <p class="text-sm text-zinc-600 leading-relaxed transition-colors duration-300 dark:text-zinc-400">
              {item.description}
            </p>
            <p class="text-sm text-zinc-500">{item.publisher}</p>
          </a>
        ))}
      </div>
    )
  }
</Page>
